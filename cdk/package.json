{
  "name": "profilia-cdk",
  "version": "1.0.0",
  "description": "AWS CDK Infrastructure for Profilia Backend and Frontend",
  "bin": {
    "profilia-cdk": "bin/profilia-cdk.js"
  },
  "scripts": {
    "build": "npx tsc",
    "watch": "npx tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "npx tsc && cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all",
    "synth": "npx tsc && cdk synth",
    "diff": "npx tsc && cdk diff"
  },
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "s3",
    "cloudfront"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "aws-cdk": "^2.118.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.118.0",
    "constructs": "^10.3.0",
    "dotenv": "^16.3.1"
  }
}
